# SQLite database file (libsql URL). Created by `pnpm db:setup`.
DATABASE_URL="file:./data/energyos.db"
# For a hosted libSQL / Turso database use DATABASE_URL="libsql://<db>-<org>.turso.io" and set the token:
# DATABASE_AUTH_TOKEN=""

# Seed the demo accounts (owner/supervisor/operator/analyst) with the shared demo password.
# Set to "false" for a deployment that should not contain demo logins.
SEED_DEMO_USERS="true"

# Password for seeded demo accounts. Demo use only.
DEMO_PASSWORD="energyos-demo"

# Set to "true" only when the app is served over HTTPS (marks cookies Secure).
COOKIE_SECURE="false"

# Allow alert webhooks to private hosts / plain HTTP (internal gateway only).
# ALLOW_PRIVATE_WEBHOOKS="false"

# Delay (ms) before background analysis after meter ingest.
# ANALYSIS_DEBOUNCE_MS="60000"

# Live India power-market prices (IEX day-ahead). "off" for a network without internet access.
# INDIA_MARKET_FEED="iex"
