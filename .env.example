# SQLite database file (libsql URL). Created by `pnpm db:setup`.
DATABASE_URL="file:./data/energyos.db"

# Seed the demo accounts (owner/supervisor/operator/analyst) with the shared demo password.
# Set to "false" for a deployment that should not contain demo logins.
SEED_DEMO_USERS="true"

# Password for seeded demo accounts. Demo use only.
DEMO_PASSWORD="energyos-demo"

# Set to "true" only when the app is served over HTTPS (marks cookies Secure).
COOKIE_SECURE="false"
